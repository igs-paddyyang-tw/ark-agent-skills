# ark-weknora-cli 環境變數（F-7：程式碼零硬編，全部走 .env）
# 複製本檔為 .env（或由專案根 .env 提供），填入你環境的值。

# WeKnora 服務位址（必填，缺值 BAD_INPUT）
WEKNORA_API_URL=http://YOUR_WEKNORA_HOST:8080/api/v1

# API 金鑰（retrieve 權限即可；缺值 BAD_INPUT）
WEKNORA_API_KEY=

# 預設智能體 ID（endpoint=agent 且未帶 --agent-id 時使用）
WEKNORA_AGENT_ID=

# 預設知識庫 ID（endpoint=knowledge 且未帶 --kb-id 時使用；可填別名或 UUID）
WEKNORA_KB_ID=

# 底層呼叫逾時秒數（選填，預設 180）
ARK_WEKNORA_TIMEOUT=180
