// Package session 管理連線的身分與狀態：認證、token 續期、同帳號踢除。
//
// 身分只來自 token（直連平台 Redis 驗證，用戶 2026-10-06 定案 N1）。認證後
// ArkID 不可變；handler 只能從 *Session 取得身分，不能讀封包裡的 user_id。
package session

import (
	"sync"
	"sync/atomic"
	"time"

	"__MODULE__/internal/ark-go/wire"
	"__MODULE__/internal/ark-go/ws"
)

// State 是連線狀態。
type State int32

const (
	Unauthed State = iota // 只收 auth / alive / close
	Authed                // 收全部已註冊指令
)

var nextID atomic.Uint64

// Session 是一條已建立的玩家連線。
type Session struct {
	ID       uint64
	Conn     *ws.Conn
	RemoteIP string // 可信來源 IP（guard.ClientIP）
	OpenedAt time.Time

	state atomic.Int32

	mu       sync.Mutex
	arkID    string
	token    string
	authedAt time.Time
	failures int
	values   map[string]any

	lastActive atomic.Int64 // unix nano

	// 由 dispatch 使用：sn 遞增檢查
	LastSN    int64
	HasLastSN bool
}

// New 建立一個未認證的 session。
func New(conn *ws.Conn, remoteIP string, now time.Time) *Session {
	s := &Session{ID: nextID.Add(1), Conn: conn, RemoteIP: remoteIP, OpenedAt: now}
	s.lastActive.Store(now.UnixNano())
	return s
}

// State 回傳目前狀態。
func (s *Session) State() State { return State(s.state.Load()) }

// ArkID 回傳已認證的玩家 ID；未認證時為空字串。
func (s *Session) ArkID() string {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.arkID
}

// Token 回傳認證用的 token。
func (s *Session) Token() string {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.token
}

// AuthedAt 回傳認證時間。
func (s *Session) AuthedAt() time.Time {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.authedAt
}

// bind 綁定身分，只會成功一次。
func (s *Session) bind(arkID, token string, now time.Time) bool {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.arkID != "" {
		return false
	}
	s.arkID, s.token, s.authedAt = arkID, token, now
	s.state.Store(int32(Authed))
	return true
}

// addFailure 認證失敗次數 +1，回傳累計次數。
func (s *Session) addFailure() int {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.failures++
	return s.failures
}

// Touch 記錄收到封包的時間（心跳）。
func (s *Session) Touch(now time.Time) { s.lastActive.Store(now.UnixNano()) }

// LastActive 回傳最後收到封包的時間。
func (s *Session) LastActive() time.Time { return time.Unix(0, s.lastActive.Load()) }

// Set / Get 存放業務模組的連線資料（例如所在桌）。
func (s *Session) Set(key string, v any) {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.values == nil {
		s.values = make(map[string]any)
	}
	s.values[key] = v
}

func (s *Session) Get(key string) any {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.values[key]
}

// Send 送一則伺服器主動指令 {"cmd":..,"data":..,"sys":..}。
func (s *Session) Send(sys, cmd string, data any) error {
	raw, err := ws.RawData(data)
	if err != nil {
		return err
	}
	p := &wire.Packet{Cmd: cmd, Data: raw}
	if sys != "" {
		p.Sys = wire.Sys(sys)
	}
	return s.Conn.Send(p)
}

// Reply 回應一則指令 {"ret":..,"data":..,"sn":..,"sys":..}。
func (s *Session) Reply(req *wire.Packet, data any) error {
	raw, err := ws.RawData(data)
	if err != nil {
		return err
	}
	return s.Conn.Send(&wire.Packet{Ret: req.Cmd, Data: raw, SN: req.SN, Sys: req.Sys})
}

// Close 關閉連線。
func (s *Session) Close(code int, reason string) { s.Conn.Close(code, reason) }
