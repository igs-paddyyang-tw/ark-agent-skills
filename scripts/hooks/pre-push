#!/usr/bin/env bash
# 本 repo 的 pre-push：**只在這次推送刪掉了 skill 時**才檢查消費端。
#
# 為什麼不是排程：
#   殘留只在一個時刻產生 —— 上游移除／改名 skill 的那一刻。
#   排程掃出來的東西沒有收件人，而「沒人讀的紅燈」正是那 241 處累積起來的原因
#   （2026-09-14：最久的殘留躺了幾個月，期間每台機器都跑過很多次別的檢查）。
#
# 嚴重度分兩級，因為它們的修復成本不同：
#   🔴 擋下  —— 消費端的 **sync 矩陣** 還列著這個名字：下次 sync 會直接印「來源缺 X，跳過」，
#              而修法只是改另一個 repo 的一行，推的人當下就能做
#   ⚠️ 只警告 —— 只有**已部署複本**指著它：那要逐一判「這個 agent 該不該有接手者」
#              （三段判準的第③段），不該在推送當下逼人做決定
#
# 安裝：ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
# 略過：ARK_SKIP_CONSUMER_CHECK=1 git push …
# 換消費端根目錄（測試／異地佈局）：ARK_CONSUMERS=/path/to/projects
set -uo pipefail
[[ "${ARK_SKIP_CONSUMER_CHECK:-0}" == "1" ]] && exit 0

REPO="$(git rev-parse --show-toplevel)"
CHECKER="$REPO/scripts/check_consumers.py"
[[ -f "$CHECKER" ]] || exit 0

# 這次推送刪掉了哪些 skill？（讀 stdin 的 <local ref> <local sha> <remote ref> <remote sha>）
deleted=""
while read -r _ lsha _ rsha; do
  [[ "$lsha" =~ ^0+$ ]] && continue                 # 刪分支，不管
  if [[ "$rsha" =~ ^0+$ ]]; then range="$lsha"; else range="$rsha..$lsha"; fi
  deleted+=$'\n'"$(git diff --diff-filter=D --name-only $range -- 'ark-*/SKILL.md' 2>/dev/null \
                   | sed 's|/SKILL.md$||')"
done
deleted="$(printf '%s' "$deleted" | grep -v '^$' | sort -u)"

# ── v2（2026-09-17）：偵測 major bump / 契約變更（AC-19，D-x 決策後）──
# 既有只管「移除」；v2 加「同名 skill 的破壞性升版」。
# 用 origin/main..HEAD 的 diff（不搶 pre-push 的 stdin），偵測 version major 變化。
majorbump=""
base="$(git merge-base origin/main HEAD 2>/dev/null || echo '')"
if [[ -n "$base" ]]; then
  for f in $(git diff --name-only "$base..HEAD" -- 'ark-*/SKILL.md' 2>/dev/null); do
    old="$(git show "$base:$f" 2>/dev/null | grep -m1 '^\s*version:' | grep -oE '[0-9]+' | head -1)"
    new="$(git show "HEAD:$f" 2>/dev/null | grep -m1 '^\s*version:' | grep -oE '[0-9]+' | head -1)"
    [[ -n "$old" && -n "$new" && "$new" -gt "$old" ]] && majorbump+=$'\n'"$(dirname "$f") ($old.x→$new.0)"
  done
fi
if [[ -n "$(printf '%s' "$majorbump" | grep -v '^$')" ]]; then
  echo "pre-push: 📢 偵測到 major 升版（破壞性）："
  printf '%s' "$majorbump" | grep -v '^$' | sed 's|^|    |'
  echo "pre-push: 建議產 Alignment Notice 廣播到 team 頻道（D-1）："
  echo "          python .kiro/skills/ark-skills-align/scripts/check_consumers.py --impact --json impact.json"
  echo "          python .kiro/skills/ark-skills-align/scripts/notice_build.py impact.json --out docs/reports/review/\$(date +%F)-align-notice.md"
fi

[[ -z "$deleted" ]] && exit 0

echo "pre-push: 本次推送移除了 skill：$(printf '%s' "$deleted" | tr '\n' ' ')"
echo "pre-push: 檢查消費端有沒有人還指著它們 …"

CONSUMERS_ARG=()
[[ -n "${ARK_CONSUMERS:-}" ]] && CONSUMERS_ARG=(--consumers "$ARK_CONSUMERS")
out="$(python3 "$CHECKER" --repo "$REPO" "${CONSUMERS_ARG[@]}" 2>&1)"; rc=$?
[[ $rc -eq 0 ]] && { echo "pre-push: ✅ 消費端無懸空引用"; exit 0; }

# 只挑「這次刪掉的那幾個」的段落看，別被既有存量洗掉
blocking=0
while read -r name; do
  [[ -z "$name" ]] && continue
  seg="$(printf '%s' "$out" | awk -v n="  $name（" 'index($0,n)==1{f=1;next} /^  ark-/||/^掃了/||/^移除前照/{f=0} f')"
  [[ -z "$seg" ]] && continue
  echo "$seg" | sed "s|^|    |"
  printf '%s' "$seg" | grep -q '\[matrix' && blocking=1
done <<< "$deleted"

if [[ $blocking -eq 1 ]]; then
  echo "pre-push: 🔴 上列 skill 仍在某個消費端的 sync 矩陣裡 —— 下次 sync 會靜默跳過它。"
  echo "          請一併改掉那幾行（通常是換成接手者），或確認後："
  echo "          ARK_SKIP_CONSUMER_CHECK=1 git push ..."
  exit 1
fi
echo "pre-push: ⚠️ 只有已部署複本指著它們 —— 不擋，但那些複本要有人跟上。"
echo "          逐一判第③段：這個 agent 該不該有接手者（scaffolder 給職人角色通常是「刪，不是換」）。"
exit 0
