{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ark-agent-role-profile/role-profile.schema.json",
  "title": "role-profile",
  "description": "Agent 角色定位契約。訪談產出、profile_lint 守門、render_profile 消費。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role_id", "base_role", "identity", "stance", "tradeoffs",
               "scope", "hard_stops", "voice", "relationships", "metrics",
               "knowledge_domains", "skills", "examples"],
  "properties": {
    "schema_version": { "const": 1 },
    "role_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
    "base_role": { "type": "string", "pattern": "^([a-z0-9]+(-[a-z0-9]+)*|custom)$" },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emoji", "one_liner", "language"],
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 20 },
        "emoji": { "type": "string", "minLength": 1, "maxLength": 4 },
        "one_liner": { "type": "string", "minLength": 6, "maxLength": 60 },
        "language": { "type": "string", "enum": ["zh-TW", "en", "ja"] }
      }
    },

    "stance": {
      "type": "array", "minItems": 3, "maxItems": 6,
      "items": { "type": "string", "minLength": 8, "maxLength": 80 }
    },

    "tradeoffs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambiguity", "speed_vs_quality", "risk"],
      "properties": {
        "ambiguity": { "enum": ["ask", "minimal_then_confirm", "conservative"] },
        "speed_vs_quality": { "enum": ["speed", "quality"] },
        "risk": { "enum": ["conservative", "balanced", "aggressive"] }
      }
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does", "does_not", "escalates_to"],
      "properties": {
        "does": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string" } },
        "does_not": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
        "escalates_to": { "type": ["string", "null"] }
      }
    },

    "hard_stops": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": { "type": "string", "minLength": 4, "maxLength": 60 }
    },

    "anti_patterns": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pattern", "correction"],
        "properties": {
          "pattern": { "type": "string", "maxLength": 60 },
          "correction": { "type": "string", "maxLength": 80 }
        }
      }
    },

    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "max_chars", "format"],
      "properties": {
        "tone": { "type": "string", "maxLength": 30 },
        "max_chars": { "type": "integer", "minimum": 50, "maximum": 1000 },
        "banned_openers": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "format": { "type": "string", "maxLength": 80 }
      }
    },

    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reports_to": { "type": ["string", "null"] },
        "delegates_to": { "type": "array", "items": { "type": "string" } },
        "consults": { "type": "array", "items": { "type": "string" } }
      }
    },

    "metrics": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "target"],
        "properties": { "name": { "type": "string" }, "target": { "type": "string" } }
      }
    },

    "knowledge_domains": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string" } },

    "skills": {
      "type": "array", "maxItems": 12,
      "description": "字串形式（= 任意版本，永久相容）或物件形式 {name, version?, tier?}（schema 1.1，供 skills-align v2 的版本對齊與 tier 分層）",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^ark-[a-z0-9-]+$" },
          {
            "type": "object", "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^ark-[a-z0-9-]+$" },
              "version": { "type": "string", "description": "semver 範圍，如 '>=2.0 <3' / '^2.0.0'" },
              "tier": { "enum": ["base", "role", "domain"], "description": "覆寫 role-skills-map 的預設 tier" }
            }
          }
        ]
      }
    },

    "examples": {
      "type": "array", "minItems": 2, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["situation", "response"],
        "properties": {
          "situation": { "type": "string", "maxLength": 80 },
          "response": { "type": "string", "maxLength": 200 },
          "kind": { "enum": ["typical", "pushback"] }
        }
      }
    }
  }
}
